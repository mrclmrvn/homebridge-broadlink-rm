{
  "pluginAlias": "BroadlinkRM",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Broadlink RM plugin with native device support and no native compilation dependencies.",
  "footerDisplay": "For issues or discussions, visit [GitHub](https://github.com/mrclmrvn/homebridge-broadlink-rm).",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Platform Name",
        "type": "string",
        "default": "BroadlinkRM",
        "required": true
      },
      "disableDiscovery": {
        "title": "Disable UDP Auto-Discovery",
        "type": "boolean",
        "default": false,
        "description": "Disable automatic local network broadcast discovery if all devices are defined in hosts."
      },
      "hosts": {
        "title": "Configured Devices (Hosts)",
        "type": "array",
        "description": "Optional list of manually configured Broadlink RM devices by IP and MAC address.",
        "items": {
          "type": "object",
          "properties": {
            "address": {
              "title": "IP Address",
              "type": "string",
              "format": "ipv4",
              "required": true,
              "placeholder": "192.168.1.164"
            },
            "mac": {
              "title": "MAC Address",
              "type": "string",
              "required": true,
              "placeholder": "ec:0b:ae:0c:a2:91"
            },
            "isRM4": {
              "title": "Is RM4 Device",
              "type": "boolean",
              "default": true,
              "description": "Set to true for RM4 Mini, RM4 Pro, RM4C devices."
            },
            "isRFSupported": {
              "title": "Supports RF (433MHz / 315MHz)",
              "type": "boolean",
              "default": false,
              "description": "Enable for RM Pro or RM4 Pro models."
            },
            "devType": {
              "title": "Exact Device Type (hexadecimal)",
              "type": "string",
              "description": "Optional discovered ID, e.g. 0x520c. Overrides isRM4/isRFSupported model selection."
            },
            "port": {
              "title": "UDP Port",
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        }
      },
      "accessories": {
        "title": "Accessories",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Accessory Name",
              "type": "string",
              "required": true
            },
            "type": {
              "title": "Accessory Type",
              "type": "string",
              "required": true,
              "oneOf": [
                {
                  "title": "Air Conditioner (Thermostat)",
                  "enum": [
                    "air-conditioner"
                  ]
                },
                {
                  "title": "Fan",
                  "enum": [
                    "fan"
                  ]
                },
                {
                  "title": "Switch (On/Off/Stateless)",
                  "enum": [
                    "switch"
                  ]
                },
                {
                  "title": "Learn Code Button",
                  "enum": [
                    "learn-code"
                  ]
                },
                {
                  "title": "Television (separately paired)",
                  "enum": [
                    "tv"
                  ]
                },
                {
                  "title": "Light",
                  "enum": [
                    "light"
                  ]
                },
                {
                  "title": "Window Covering / Blinds",
                  "enum": [
                    "window-covering"
                  ]
                },
                {
                  "title": "Garage Door Opener",
                  "enum": [
                    "garage-door-opener"
                  ]
                },
                {
                  "title": "Lock",
                  "enum": [
                    "lock"
                  ]
                },
                {
                  "title": "Heater / Cooler",
                  "enum": [
                    "heater-cooler"
                  ]
                },
                {
                  "title": "Air Purifier",
                  "enum": [
                    "air-purifier"
                  ]
                },
                {
                  "title": "Humidifier / Dehumidifier",
                  "enum": [
                    "humidifier-dehumidifier"
                  ]
                },
                {
                  "title": "Temperature Sensor",
                  "enum": [
                    "temperatureSensor"
                  ]
                },
                {
                  "title": "Humidity Sensor",
                  "enum": [
                    "humiditySensor"
                  ]
                },
                {
                  "title": "Outlet",
                  "enum": [
                    "outlet"
                  ]
                },
                {
                  "title": "Window",
                  "enum": [
                    "window"
                  ]
                },
                {
                  "title": "Fan (legacy On control)",
                  "enum": [
                    "fanv1"
                  ]
                },
                {
                  "title": "Switch Sequence",
                  "enum": [
                    "switch-multi"
                  ]
                },
                {
                  "title": "Switch Repeated Code",
                  "enum": [
                    "switch-repeat"
                  ]
                },
                {
                  "title": "Switch Repeated Sequence",
                  "enum": [
                    "switch-multi-repeat"
                  ]
                },
                {
                  "title": "Learn RF Code (Pro models)",
                  "enum": [
                    "learn-rf"
                  ]
                }
              ]
            },
            "host": {
              "title": "Host (IP or MAC)",
              "type": "string",
              "description": "The IP or MAC address of the Broadlink device that controls this accessory."
            },
            "disabled": {
              "title": "Disabled",
              "type": "boolean",
              "default": false
            },
            "coolOnly": {
              "title": "Cool Only",
              "type": "boolean",
              "default": true,
              "description": "For Air Conditioners: restricts available modes to Off and Cool only."
            },
            "minTemperature": {
              "title": "Min Temperature (\u00b0C)",
              "type": "integer",
              "default": 16
            },
            "maxTemperature": {
              "title": "Max Temperature (\u00b0C)",
              "type": "integer",
              "default": 30
            },
            "defaultCoolTemperature": {
              "title": "Default Cool Temperature (\u00b0C)",
              "type": "integer",
              "default": 24
            },
            "tempStepSize": {
              "title": "Temperature Step Size (\u00b0C)",
              "type": "number",
              "default": 1
            },
            "data": {
              "title": "IR/RF Hex Data",
              "type": [
                "object",
                "array",
                "string"
              ],
              "description": "Accessory code mappings; each command can be a string, sequence array, or {data, sendCount, interval, pause}. Top-level string/array data is for switches only.",
              "properties": {
                "pictureMode": {
                  "title": "TV Picture Mode Codes",
                  "type": "object",
                  "properties": {
                    "other": {
                      "type": [
                        "string",
                        "array",
                        "object"
                      ]
                    },
                    "standard": {
                      "type": [
                        "string",
                        "array",
                        "object"
                      ]
                    },
                    "calibrated": {
                      "type": [
                        "string",
                        "array",
                        "object"
                      ]
                    },
                    "calibratedDark": {
                      "type": [
                        "string",
                        "array",
                        "object"
                      ]
                    },
                    "vivid": {
                      "type": [
                        "string",
                        "array",
                        "object"
                      ]
                    },
                    "game": {
                      "type": [
                        "string",
                        "array",
                        "object"
                      ]
                    },
                    "computer": {
                      "type": [
                        "string",
                        "array",
                        "object"
                      ]
                    },
                    "custom": {
                      "type": [
                        "string",
                        "array",
                        "object"
                      ]
                    }
                  },
                  "description": "TV only. Named presets or numeric HomeKit keys 0\u20137; each code accepts a shared sequence."
                }
              }
            },
            "speedSteps": {
              "title": "Number of Fan Speeds",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "stepSize": {
              "title": "Fan Speed Step (%)",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "hideSwingMode": {
              "title": "Hide Fan Swing Control",
              "type": "boolean",
              "default": false
            },
            "hideRotationDirection": {
              "title": "Hide Fan Direction Control",
              "type": "boolean",
              "default": false
            },
            "defaultBrightness": {
              "title": "Default Light Brightness (%)",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "useLastKnownBrightness": {
              "title": "Restore Last Light Brightness",
              "type": "boolean",
              "default": false
            },
            "onDelay": {
              "title": "Light / Thermostat Power-on Delay (seconds)",
              "type": "number",
              "minimum": 0
            },
            "totalDurationOpen": {
              "title": "Covering Full Open Travel (seconds)",
              "type": "number",
              "minimum": 0.001,
              "maximum": 2147483.647
            },
            "totalDurationClose": {
              "title": "Covering Full Close Travel (seconds)",
              "type": "number",
              "minimum": 0.001,
              "maximum": 2147483.647
            },
            "openDuration": {
              "title": "Garage Open Travel (seconds)",
              "type": "number",
              "minimum": 0,
              "maximum": 2147483.647
            },
            "closeDuration": {
              "title": "Garage Close Travel (seconds)",
              "type": "number",
              "minimum": 0,
              "maximum": 2147483.647
            },
            "openCloseDuration": {
              "title": "Garage Shared Travel Duration (seconds)",
              "type": "number",
              "minimum": 0,
              "maximum": 2147483.647
            },
            "lockDuration": {
              "title": "Lock Travel Duration (seconds)",
              "type": "number",
              "minimum": 0,
              "maximum": 2147483.647
            },
            "unlockDuration": {
              "title": "Unlock Travel Duration (seconds)",
              "type": "number",
              "minimum": 0,
              "maximum": 2147483.647
            },
            "lockUnlockDuration": {
              "title": "Shared Lock/Unlock Duration (seconds)",
              "type": "number",
              "minimum": 0,
              "maximum": 2147483.647
            },
            "autoCloseDelay": {
              "title": "Garage Automatic Close Delay (seconds)",
              "type": "number",
              "minimum": 0,
              "maximum": 2147483.647
            },
            "autoLockDelay": {
              "title": "Automatic Lock Delay (seconds)",
              "type": "number",
              "minimum": 0,
              "maximum": 2147483.647
            },
            "initialPosition": {
              "title": "Covering Initial Position (%)",
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "Assumed startup position; no position sensor is read. Defaults to 0."
            },
            "sendStopAt0": {
              "title": "Covering: Send Stop at Fully Closed",
              "type": "boolean",
              "default": false
            },
            "sendStopAt100": {
              "title": "Covering: Send Stop at Fully Open",
              "type": "boolean",
              "default": false
            },
            "allowResend": {
              "title": "Covering / Thermostat / Light: Allow Resend",
              "type": "boolean",
              "default": false
            },
            "initialDelay": {
              "title": "Covering Command Delay (seconds)",
              "type": "number",
              "minimum": 0,
              "maximum": 2147483.647
            },
            "sensorPollInterval": {
              "title": "Sensor Poll Interval (seconds)",
              "type": "number",
              "minimum": 0,
              "maximum": 2147483.647
            },
            "temperatureUpdateFrequency": {
              "title": "Temperature Update Interval (seconds)",
              "type": "number",
              "minimum": 0,
              "maximum": 2147483.647
            },
            "humidityUpdateFrequency": {
              "title": "Humidity Update Interval (seconds)",
              "type": "number",
              "minimum": 0,
              "maximum": 2147483.647
            },
            "interval": {
              "title": "Switch Sequence / Repeat Interval (seconds)",
              "type": "number",
              "minimum": 0,
              "maximum": 2147483.647
            },
            "onDuration": {
              "title": "On Duration (seconds)",
              "type": "number",
              "minimum": 0,
              "maximum": 2147483.647
            },
            "offDuration": {
              "title": "Off Duration (seconds)",
              "type": "number",
              "minimum": 0,
              "maximum": 2147483.647
            },
            "sendCount": {
              "title": "Switch Repeat Count",
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "onSendCount": {
              "title": "Switch On Repeat Count",
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "offSendCount": {
              "title": "Switch Off Repeat Count",
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "humidifierOnly": {
              "title": "Humidifier Only",
              "type": "boolean"
            },
            "deHumidifierOnly": {
              "title": "Dehumidifier Only",
              "type": "boolean"
            },
            "noHumidity": {
              "title": "Disable Humidity Automation / Secondary Sensor",
              "type": "boolean"
            },
            "showLockPhysicalControls": {
              "title": "Show Appliance Control Lock",
              "type": "boolean"
            },
            "turnOnWhenOff": {
              "title": "Thermostat / HeaterCooler: Send On When Activating",
              "type": "boolean"
            },
            "stateless": {
              "title": "Switch / Light: Stateless Local Reset",
              "type": "boolean"
            },
            "enableAutoOff": {
              "title": "Automatic Power: Send Off Automatically",
              "type": "boolean"
            },
            "enableAutoOn": {
              "title": "Automatic Power: Send On Automatically",
              "type": "boolean"
            },
            "temperatureFilePath": {
              "title": "Temperature Sensor File",
              "type": "string"
            },
            "humidityFilePath": {
              "title": "Humidity Sensor File",
              "type": "string"
            },
            "temperatureAdjustment": {
              "title": "Temperature Adjustment (\u00b0C)",
              "type": "number"
            },
            "humidityAdjustment": {
              "title": "Humidity Adjustment (%)",
              "type": "number"
            },
            "humidifierThreshold": {
              "title": "Humidify Below (%)",
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "dehumidifierThreshold": {
              "title": "Dehumidify Above (%)",
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "heatingThresholdTemperature": {
              "title": "HeaterCooler Heating Threshold",
              "type": "number"
            },
            "coolingThresholdTemperature": {
              "title": "HeaterCooler Cooling Threshold",
              "type": "number"
            },
            "temperatureUnits": {
              "title": "HeaterCooler Configuration Units",
              "type": "string",
              "enum": [
                "c",
                "f",
                "C",
                "F"
              ]
            },
            "tempSourceUnits": {
              "title": "Temperature File / MQTT Units",
              "type": "string",
              "enum": [
                "c",
                "f",
                "C",
                "F"
              ]
            },
            "defaultMode": {
              "title": "Thermostat / HeaterCooler Default Mode",
              "type": "string",
              "enum": [
                "heat",
                "cool",
                "auto"
              ],
              "description": "auto is Thermostat-only and requires device Auto mappings or replaceAutoMode."
            },
            "defaultRotationSpeed": {
              "title": "HeaterCooler Default Fan Speed (%)",
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "fanStepSize": {
              "title": "HeaterCooler Fan Speed Step (%)",
              "type": "number",
              "minimum": 1,
              "maximum": 100
            },
            "mqttURL": {
              "title": "MQTT Broker URL",
              "type": "string",
              "description": "Optional mqtt://, mqtts://, ws:// or wss:// broker. MQTT measurements take precedence over native/file readings."
            },
            "mqttUsername": {
              "title": "MQTT Username",
              "type": "string"
            },
            "mqttPassword": {
              "title": "MQTT Password",
              "type": "string",
              "format": "password"
            },
            "mqttMaxAge": {
              "title": "MQTT Maximum Reading Age (seconds)",
              "type": "number",
              "minimum": 0,
              "maximum": 2147483,
              "default": 300,
              "description": "Local receipt age; 0 disables expiry while connected. Retained payload timestamps are not interpreted."
            },
            "mqttTopic": {
              "title": "MQTT Topic(s)",
              "type": [
                "string",
                "array"
              ],
              "description": "A combined topic string or entries with identifier and topic; see the MQTT setup guide.",
              "items": {
                "type": "object",
                "properties": {
                  "identifier": {
                    "type": "string",
                    "enum": [
                      "temperature",
                      "humidity",
                      "combined",
                      "unknown",
                      "battery"
                    ]
                  },
                  "topic": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string",
                    "description": "Optional dot-separated field path for an explicit temperature, humidity or battery identifier."
                  }
                },
                "required": [
                  "identifier",
                  "topic"
                ]
              }
            },
            "pingIPAddress": {
              "title": "Appliance Power Detection IPv4 Address",
              "type": "string",
              "description": "Switch/outlet, TV, fan/Fan v1 and purifier only. Appliance address, not the Broadlink host."
            },
            "pingUseArp": {
              "title": "Use ARP Cache for Power Estimate",
              "type": "boolean",
              "description": "Cache presence may be stale; this does not send an ARP probe."
            },
            "pingIPAddressStateOnly": {
              "title": "Observe Power Without Guarding Commands",
              "type": "boolean",
              "description": "For outlets, updates OutletInUse independently of On."
            },
            "pingFrequency": {
              "title": "Power Poll Interval (seconds)",
              "type": "number",
              "minimum": 0.001,
              "maximum": 2147483
            },
            "pingTimeout": {
              "title": "Power Probe Timeout (seconds)",
              "type": "number",
              "minimum": 0.001,
              "maximum": 60
            },
            "pingGrace": {
              "title": "Power State Grace After Send (seconds)",
              "type": "number",
              "minimum": 0,
              "maximum": 2147483
            },
            "speedCycle": {
              "title": "Fan Uses a Speed-Cycle Button",
              "type": "boolean"
            },
            "speedCycleInterval": {
              "title": "Fan Cycle Pulse Gap (seconds)",
              "type": "number",
              "minimum": 0,
              "maximum": 2147483
            },
            "defaultSpeedStep": {
              "title": "Fan Assumed Power-on Speed Step",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "defaultFanSpeed": {
              "title": "Fan Reset Speed (%)",
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "alwaysResetToDefaults": {
              "title": "Reset Fan Speed on Direct Power-on",
              "type": "boolean"
            },
            "exclusives": {
              "title": "Mutually Exclusive Light Names",
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Updates other lights to Off locally; does not transmit their off codes."
            },
            "disableAutomaticOff": {
              "title": "Disable Legacy Automatic Off",
              "type": "boolean",
              "description": "For fan/light/TV/Thermostat controllers, explicit false enables the timer and true disables it. Overrides the corresponding enable flag."
            },
            "disableAutomaticOn": {
              "title": "Disable Legacy Automatic On",
              "type": "boolean",
              "description": "For fan/light/TV/Thermostat controllers, explicit false enables the timer and true disables it. Overrides the corresponding enable flag."
            },
            "closedSensor": {
              "title": "Garage Closed Endpoint Feedback",
              "type": "object",
              "description": "Configure exactly one filePath or mqttURL. True means endpoint activated, obstructed, or bolt secured. See power-and-feedback guide.",
              "properties": {
                "filePath": {
                  "title": "Feedback File Path",
                  "type": "string"
                },
                "pollInterval": {
                  "title": "Feedback Poll Interval (seconds)",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2147483
                },
                "maxAge": {
                  "title": "Maximum Reading Age (seconds)",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2147483,
                  "description": "Defaults to 300. For files uses modification time; MQTT uses receipt time. 0 disables expiry."
                },
                "mqttURL": {
                  "title": "MQTT Broker URL",
                  "type": "string",
                  "description": "Optional mqtt://, mqtts://, ws:// or wss:// broker. MQTT measurements take precedence over native/file readings."
                },
                "mqttUsername": {
                  "title": "MQTT Username",
                  "type": "string"
                },
                "mqttPassword": {
                  "title": "MQTT Password",
                  "type": "string",
                  "format": "password"
                },
                "mqttTopic": {
                  "title": "MQTT Topic(s)",
                  "type": [
                    "string",
                    "array"
                  ],
                  "description": "A combined topic string or entries with identifier and topic; see the MQTT setup guide.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "identifier": {
                        "type": "string",
                        "enum": [
                          "contact",
                          "lock",
                          "obstruction",
                          "jam",
                          "combined",
                          "unknown"
                        ]
                      },
                      "topic": {
                        "type": "string"
                      },
                      "path": {
                        "type": "string",
                        "description": "Optional explicit binary measurement path, including jam."
                      }
                    },
                    "required": [
                      "identifier",
                      "topic"
                    ]
                  }
                }
              }
            },
            "openSensor": {
              "title": "Garage Open Endpoint Feedback",
              "type": "object",
