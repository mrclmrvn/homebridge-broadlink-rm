{
  "name": "@mrclmrvn/homebridge-broadlink-rm",
  "displayName": "Homebridge Broadlink RM",
  "version": "5.0.6",
  "description": "Modern Broadlink RM plugin for Homebridge with native RM4 support, zero native compilation dependencies, and TypeScript architecture",
  "license": "ISC",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cli": "ts-node src/cli.ts",
    "prepublishOnly": "npm test",
    "test": "npm run build && node --test test/v5/*.test.js",
    "prepack": "npm run build && node scripts/build-config-editor.mjs",
    "test:homebridge": "node test/compatibility/homebridge-info.js && npm test"
  },
  "keywords": [
    "homebridge-plugin",
    "broadlink",
    "rm pro",
    "rm mini",
    "rm4",
    "rm4 pro",
    "rm4 mini"
  ],
  "engines": {
    "node": "^22.12.0 || ^24 || ^26",
    "homebridge": "^1.6.0 || ^2.0.0"
  },
  "author": {
    "name": "mrclmrvn"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrclmrvn/homebridge-broadlink-rm.git"
  },
  "dependencies": {
    "mqtt": "^5.16.1"
  },
  "devDependencies": {
    "@types/node": "^22.8.7",
    "esbuild": "0.28.2",
    "homebridge": "^2.0.0-beta.0",
    "monaco-editor": "0.57.0",
    "mqtt-packet": "^9.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "files": [
    "dist",
    "config.schema.json",
    "homebridge-ui/public",
    "config-v5-sample.json",
    "docs",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "broadlink-rm": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
